{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/kaggle-runner/schemas/experiment_spec.schema.json",
  "title": "Kaggle Runner ExperimentSpec v1.0",
  "type": "object",
  "required": ["schema_version", "experiment_id", "attempt_id", "project", "objective", "source", "parameters", "seed", "protocol", "authorization", "expected_outputs", "primary_metric"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "experiment_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"},
    "attempt_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"},
    "project": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "source": {"type": "object", "required": ["kind", "root", "entrypoint"], "properties": {
      "kind": {"enum": ["python", "notebook"]}, "root": {"type": "string", "minLength": 1},
      "entrypoint": {"type": "string", "pattern": "\\.(py|ipynb)$"},
      "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "revision": {"type": ["string", "null"]},
      "include": {"type": "array", "items": {"type": "string"}},
      "exclude": {"type": "array", "items": {"type": "string"}},
      "install_requirements": {"type": "boolean"},
      "max_source_mb": {"type": "integer", "minimum": 1, "maximum": 25}
    }},
    "parameters": {"type": "object"},
    "seed": {"type": "integer", "minimum": 0},
    "protocol": {"type": "object", "required": ["id", "dataset_split"], "properties": {
      "id": {"type": "string", "minLength": 1}, "dataset_split": {"type": "string", "minLength": 1}
    }},
    "datasets": {"type": "array", "items": {"oneOf": [{"type": "string"}, {"type": "object", "required": ["ref"], "properties": {"ref": {"type": "string"}, "version": {"type": "string"}}}]}},
    "models": {"type": "array", "items": {"oneOf": [{"type": "string"}, {"type": "object", "required": ["ref"], "properties": {"ref": {"type": "string"}}}]}},
    "resources": {"type": "object", "properties": {
      "accelerator": {"enum": ["cpu", "t4x2"]},
      "max_concurrent": {"type": "integer", "minimum": 1, "maximum": 2},
      "required_gpu_hours": {"type": "number", "exclusiveMinimum": 0},
      "enable_internet": {"type": "boolean"}
    }},
    "authorization": {"type": "object", "required": ["allowed_profiles"], "properties": {
      "allowed_profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "requires_submit_approval": {"type": "boolean"}
    }},
    "expected_outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "result_file": {"type": "string"},
    "primary_metric": {"type": "object", "required": ["name", "unit", "higher_is_better"], "properties": {
      "name": {"type": "string", "minLength": 1},
      "unit": {"enum": ["fraction", "percent", "count", "seconds", "custom"]},
      "higher_is_better": {"type": "boolean"}
    }}
  },
  "additionalProperties": true
}
