# EXAMPLE ONLY — never commit real tokens. Real .env must be private (chmod 600).
# Legacy/default account is optional when you only use team profiles.
KAGGLE_OWNER=your_kaggle_username
EMAIL=you@example.com
KAGGLE_API_TOKEN=YOUR_API_TOKEN_HERE

# Team accounts in the SAME .env file:
KGR_TEAM_PROFILES=alice,bob
KGR_TEAM_ALICE_USERNAME=alice_kaggle_username
KGR_TEAM_ALICE_API_TOKEN=ALICE_API_TOKEN_HERE
KGR_TEAM_ALICE_EMAIL=alice@example.com
KGR_TEAM_BOB_USERNAME=bob_kaggle_username
KGR_TEAM_BOB_API_TOKEN=BOB_API_TOKEN_HERE
# KGR_TEAM_BOB_EMAIL is optional
