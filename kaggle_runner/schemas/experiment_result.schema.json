{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/kaggle-runner/schemas/experiment_result.schema.json",
  "title": "Kaggle Runner ExperimentResult v1.0",
  "type": "object",
  "required": ["schema_version", "experiment_id", "attempt_id", "status", "seed", "dataset", "protocol_id", "source_sha256", "metrics", "samples_evaluated", "runtime_seconds", "artifacts"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "experiment_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "status": {"const": "succeeded"},
    "seed": {"type": "integer", "minimum": 0},
    "dataset": {"type": "object", "required": ["ref", "split"], "properties": {
      "ref": {"type": "string", "minLength": 1}, "split": {"type": "string", "minLength": 1}
    }},
    "protocol_id": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "metrics": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object", "required": ["value", "unit", "higher_is_better"], "properties": {
      "value": {"type": "number"}, "unit": {"enum": ["fraction", "percent", "count", "seconds", "custom"]},
      "higher_is_better": {"type": "boolean"}
    }}},
    "samples_evaluated": {"type": "integer", "minimum": 1},
    "runtime_seconds": {"type": "number", "minimum": 0},
    "artifacts": {"type": "array", "items": {"oneOf": [{"type": "string"}, {"type": "object", "required": ["path"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string"}}}]}}
  }
}
